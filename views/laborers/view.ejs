
<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        <%= laborer.name %>
    </title>

    <link
        rel="stylesheet"
        href="/css/style.css"
    >

</head>

<body>

<div class="container">

    <h1>
        <%= laborer.name %>
    </h1>


    <div class="laborer-details">

        <p>

            <strong>
                Laborer ID:
            </strong>

            #<%= laborer.laborerId %>

        </p>


        <p>

            <strong>
                Contact:
            </strong>

            <%= laborer.contactInfo || "-" %>

        </p>


        <p>

            <strong>
                Job Role:
            </strong>

            <%= laborer.jobRole || "-" %>

        </p>


        <p>

            <strong>
                Joining Date:
            </strong>

            <%= new Date(
                laborer.joiningDate
            ).toLocaleDateString("en-IN") %>

        </p>


        <p>

            <strong>
                Address:
            </strong>

            <%= laborer.address || "-" %>

        </p>

    </div>


    <hr>


    <h2>
        Payment History
    </h2>


    <%
    // Calculate total payment made to the laborer
    const totalPayment = payments.reduce(
        (total, payment) => total + Number(payment.amount || 0),
        0
    );


    // Get current month and year
    const now = new Date();

    const currentMonth = now.getMonth();
    const currentYear = now.getFullYear();


    // Calculate payment made during the current month
    const monthlyPayment = payments.reduce(
        (total, payment) => {

            const paymentDate = new Date(payment.paymentDate);

            if (
                paymentDate.getMonth() === currentMonth &&
                paymentDate.getFullYear() === currentYear
            ) {
                return total + Number(payment.amount || 0);
            }

            return total;
        },
        0
    );
%>


<div class="total-payment">

    <p>
        <strong>
            Total Payment Done:
        </strong>

        ₹ <%= totalPayment.toLocaleString("en-IN") %>
    </p>


    <p>
        <strong>
            Payment Done This Month:
        </strong>

        ₹ <%= monthlyPayment.toLocaleString("en-IN") %>
    </p>

</div>


    <br>


    <table>

        <thead>

            <tr>

                <th>
                    Date
                </th>

                <th>
                    Amount
                </th>

                <th>
                    Remarks
                </th>

                <th>
                    Slip
                </th>

            </tr>

        </thead>


        <tbody>

            <% payments.forEach(payment => { %>

                <tr>

                    <td>

                        <%= new Date(
                            payment.paymentDate
                        ).toLocaleDateString("en-IN") %>

                    </td>


                    <td>

                        ₹ <%= Number(
                            payment.amount
                        ).toLocaleString("en-IN") %>

                    </td>


                    <td>

                        <%= payment.remarks %>

                    </td>


                    <td>

                        <a
                            href="/payments/<%= payment._id %>/slip"
                        >
                            View Slip
                        </a>

                    </td>

                </tr>

            <% }) %>

        </tbody>

    </table>


    <br>


    <a href="/">
        ← Back to Dashboard
    </a>

</div>

</body>

</html>

