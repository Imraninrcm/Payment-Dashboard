<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        Payment Slip - <%= laborer.name %>
    </title>


    <style>

        * {
            box-sizing: border-box;
        }


        body {

            margin: 0;

            padding: 30px;

            font-family:
                Arial,
                Helvetica,
                sans-serif;

            background: #f2f2f2;

            color: #111;

        }


        .slip {

            width: 700px;

            max-width: 100%;

            margin: 0 auto;

            background: white;

            padding: 35px;

            border: 1px solid #222;

        }


        /* =====================================
           HEADER
        ====================================== */

        .header {

            text-align: center;

            border-bottom:
                2px solid #111;

            padding-bottom: 20px;

            margin-bottom: 25px;

        }


        .company-name {

            font-size: 28px;

            font-weight: bold;

            margin-bottom: 8px;

        }


        .slip-title {

            font-size: 20px;

            font-weight: bold;

        }


        /* =====================================
           DETAILS
        ====================================== */

        .details {

            width: 100%;

            border-collapse:
                collapse;

            margin-bottom: 25px;

        }


        .details td {

            padding: 10px;

            border:
                1px solid #ccc;

        }


        .details .label {

            width: 40%;

            font-weight: bold;

            background: #f5f5f5;

        }


        /* =====================================
           AMOUNT
        ====================================== */

        .amount-box {

            text-align: center;

            border:
                2px solid #111;

            padding: 20px;

            margin: 25px 0;

        }


        .amount-label {

            font-size: 16px;

            margin-bottom: 8px;

        }


        .amount {

            font-size: 32px;

            font-weight: bold;

        }


        /* =====================================
           REMARKS
        ====================================== */

        .remarks {

            margin-top: 20px;

            border:
                1px solid #ccc;

            padding: 15px;

        }


        .remarks-title {

            font-weight: bold;

            margin-bottom: 8px;

        }


        .remarks-text {

            white-space: pre-wrap;

            word-break: break-word;

        }


        /* =====================================
           SIGNATURE
        ====================================== */

        .signature-area {

            display: flex;

            justify-content:
                space-between;

            margin-top: 70px;

        }


        .signature {

            width: 200px;

            text-align: center;

            border-top:
                1px solid #111;

            padding-top: 8px;

        }


        /* =====================================
           BUTTONS
        ====================================== */

        .actions {

            text-align: center;

            margin-top: 25px;

        }


        .print-button {

            padding:
                10px 25px;

            border: none;

            background: #111;

            color: white;

            cursor: pointer;

            font-size: 16px;

        }


        .back-button {

            display: inline-block;

            margin-left: 10px;

            padding:
                10px 25px;

            background: #ddd;

            color: #111;

            text-decoration: none;

        }


        /* =====================================
           PRINT
        ====================================== */

        @media print {

            @page {

                size: A4;

                margin: 15mm;

            }


            body {

                padding: 0;

                margin: 0;

                background: white;

            }


            .slip {

                width: 100%;

                max-width: none;

                border:
                    1px solid #111;

                padding: 25px;

            }


            .actions {

                display: none;

            }

        }

    </style>

</head>


<body>


<div class="slip">


    <!-- HEADER -->

    <div class="header">

        <div class="company-name">

            YOUR COMPANY NAME

        </div>


        <div class="slip-title">

            LABOR PAYMENT SLIP

        </div>

    </div>


    <!-- LABORER DETAILS -->

    <table class="details">

        <tr>

            <td class="label">
                Laborer ID
            </td>

            <td>
                #<%= laborer.laborerId %>
            </td>

        </tr>


        <tr>

            <td class="label">
                Name
            </td>

            <td>
                <%= laborer.name %>
            </td>

        </tr>


        <tr>

            <td class="label">
                Contact
            </td>

            <td>
                <%= laborer.contactInfo || "-" %>
            </td>

        </tr>


        <tr>

            <td class="label">
                Job Role
            </td>

            <td>
                <%= laborer.jobRole || "-" %>
            </td>

        </tr>


        <tr>

            <td class="label">
                Joining Date
            </td>

            <td>

                <%= new Date(
                    laborer.joiningDate
                ).toLocaleDateString("en-IN") %>

            </td>

        </tr>


        <tr>

            <td class="label">
                Payment Date
            </td>

            <td>

                <%= new Date(
                    payment.paymentDate
                ).toLocaleDateString("en-IN") %>

            </td>

        </tr>

    </table>


    <!-- PAYMENT AMOUNT -->

    <div class="amount-box">

        <div class="amount-label">

            PAYMENT AMOUNT

        </div>


        <div class="amount">

            ₹ <%= Number(
                payment.amount
            ).toLocaleString(
                "en-IN",
                {
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                }
            ) %>

        </div>

    </div>


    <!-- REMARKS -->

    <div class="remarks">

        <div class="remarks-title">

            Remarks

        </div>


        <div class="remarks-text">

            <%= payment.remarks %>

        </div>

    </div>


    <!-- SIGNATURE -->

    <div class="signature-area">

        <div class="signature">

            Laborer's Signature

        </div>


        <div class="signature">

            Authorized Signature

        </div>

    </div>


    <!-- ACTIONS -->

    <div class="actions">

        <button
            class="print-button"
            onclick="window.print()"
        >
            Print Slip
        </button>


        <a
            class="back-button"
            href="/"
        >
            Dashboard
        </a>

    </div>


</div>


</body>

</html>