<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Add Payment</title>

    <link
        rel="stylesheet"
        href="/css/style.css"
    >

</head>

<body>

<div class="container">

    <h1>Add Payment</h1>

<p class="page-intro">Record a payment and keep a printable slip for your records.</p>


    <form
    class="form-card"
        action="/payments/add"
        method="POST"
    >

        <!-- LABORER -->

        <div class="form-group">

            <label for="laborerId">
                Laborer
            </label>

            <select
                id="laborerId"
                name="laborerId"
                required
            >

                <option value="">
                    Select Laborer
                </option>


                <% laborers.forEach(laborer => { %>

                    <option
                        value="<%= laborer._id %>"
                    >

                        #<%= laborer.laborerId %>
                        -
                        <%= laborer.name %>

                    </option>

                <% }) %>

            </select>

        </div>


        <!-- AMOUNT -->

        <div class="form-group">

            <label for="amount">
                Payment Amount
            </label>

            <input
                type="number"
                id="amount"
                name="amount"
                min="0"
                step="0.01"
                required
            >

        </div>


        <!-- PAYMENT DATE -->

        <div class="form-group">

            <label for="paymentDate">
                Payment Date
            </label>

            <input
                type="date"
                id="paymentDate"
                name="paymentDate"
                required
            >

        </div>


        <!-- REMARKS -->

        <div class="form-group">

            <label for="remarks">
                Remarks
            </label>

            <textarea
                id="remarks"
                name="remarks"
                rows="5"
                placeholder="Enter payment remarks..."
                required
            ></textarea>

        </div>


        <button type="submit">
            Save Payment
        </button>

    </form>


    <br>


    <a href="/">
        ← Back to Dashboard
    </a>

</div>


<script>

    // Automatically set today's date

    const paymentDate =
        document.getElementById("paymentDate");


    const today =
        new Date()
            .toISOString()
            .split("T")[0];


    paymentDate.value = today;

</script>

</body>

</html>